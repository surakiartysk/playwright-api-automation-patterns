{
  "name": "@gear-rental/class-style",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The class-first comparison: the same three services against the same contract, with client, validator, and data builder grouped into one cohesive test context per service.",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:debug": "DEBUG_API=true playwright test",
    "report": "playwright show-report",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@gear-rental/shared-contract": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "typescript": "^5.9.3"
  }
}
