{
  "name": "playwright-api-automation-patterns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API test automation reference — the same three services built two ways (hybrid functional vs class-first), against one shared contract.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --sequential test",
    "test:functional": "pnpm --filter @gear-rental/functional-style test",
    "test:class": "pnpm --filter @gear-rental/class-style test",
    "test:smoke": "pnpm -r --sequential test:smoke",
    "test:debug": "pnpm -r --sequential test:debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "check:leak": "node scripts/check-leak.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "allure": "node scripts/allure-report.mjs",
    "allure:open": "pnpm exec allure open allure-report",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm check:leak && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.17.0",
    "allure": "^3.15.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
